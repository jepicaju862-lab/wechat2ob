{
  "name": "wechat2ob",
  "version": "0.1.7",
  "private": true,
  "description": "Sync a WeChat inbox service to Markdown notes, Bases views and .duowei tables in Obsidian",
  "author": "peyote",
  "license": "GPL-3.0-only",
  "main": "main.js",
  "repository": {
    "type": "git",
    "url": "https://github.com/jepicaju862-lab/wechat2ob.git"
  },
  "homepage": "https://github.com/jepicaju862-lab/wechat2ob#readme",
  "bugs": { "url": "https://github.com/jepicaju862-lab/wechat2ob/issues" },
  "engines": { "node": ">=24.14.0" },
  "scripts": {
    "check:public": "node scripts/check-public.mjs",
    "build": "npm run check:public && tsc --noEmit && node esbuild.config.mjs && node scripts/verify-bundle.mjs",
    "test": "node scripts/test.mjs",
    "verify": "npm run build && npm test",
    "package": "npm run build && node scripts/package.mjs",
    "release:check": "node scripts/check-public.mjs --tracked && node scripts/verify-bundle.mjs"
  },
  "devDependencies": {
    "@types/node": "20.19.43",
    "esbuild": "0.20.2",
    "obsidian": "1.12.3",
    "typescript": "5.9.3"
  }
}
